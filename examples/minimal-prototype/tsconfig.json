{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": { "@multiagency/sdk": ["../../src/contract/index.ts"] }
  },
  "include": ["app.ts", "rsbuild.config.ts"]
}
