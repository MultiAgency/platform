# Build only from scripts/package-platform.mjs output, never the working repository.
FROM node:26.13.1-slim
WORKDIR /app
# Node 25+ ships without corepack; pnpm's version still comes from package.json's packageManager.
RUN npm install -g corepack@0.36.0 && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod
COPY tsconfig.json ./
COPY src ./src
COPY scripts/market-funding-proof.ts ./scripts/market-funding-proof.ts
COPY scripts/market-allocation.ts ./scripts/market-allocation.ts
COPY web/dist ./web/dist
COPY deploy ./deploy
COPY manifest.json ./release-manifest.json
ENV NODE_ENV=production DASHBOARD_FILE=/app/deploy/platform.json TRUST_PROXY=true
EXPOSE 8080
CMD ["/app/deploy/platform-entrypoint.sh"]
