{
  "compilerOptions": {
    "paths": { "@/*": ["./web/src/*"] },
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/invoice-browser.js", "test/**/*.ts", "scripts/market-funding-proof.ts"]
}
