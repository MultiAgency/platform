{
  "name": "proto",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "create-agent": "tsx --env-file-if-exists=.env src/create-agent.ts",
    "issue-grant": "tsx --env-file-if-exists=.env src/issue-grant.ts",
    "revoke-grant": "tsx --env-file-if-exists=.env src/revoke-grant.ts",
    "app-credential": "tsx src/app-credential.ts",
    "update-policy": "tsx --env-file-if-exists=.env src/update-policy.ts",
    "inspect": "tsx --env-file-if-exists=.env src/inspect.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/reconcile.ts",
    "books": "tsx --env-file-if-exists=.env src/books.ts",
    "archive": "tsx --env-file-if-exists=.env src/archive.ts",
    "smoke": "tsx src/smoke.ts",
    "run-report": "tsx src/run-report.ts",
    "demo-check": "tsx src/demo-check.ts",
    "evidence:write": "tsx scripts/evidence-docs.ts --write",
    "evidence:check": "tsx scripts/evidence-docs.ts --check && tsx scripts/evidence-receipts.ts --check",
    "contract:pack": "tsx scripts/contract-pack.ts",
    "contract:skills": "node scripts/verify-skills.mjs",
    "sdk:dev": "tsx scripts/sdk-dev.ts",
    "journal:check": "tsx scripts/check-journal-backup.ts",
    "typecheck": "tsc && tsc -p web && tsc -p examples/minimal-prototype",
    "example:build": "rsbuild build --root examples/minimal-prototype",
    "server": "tsx --env-file-if-exists=.env src/server.ts",
    "hosted": "tsx --env-file-if-exists=.env src/gateway/server.ts",
    "invoices": "tsx --env-file-if-exists=.env src/invoices-server.ts",
    "web": "rsbuild dev --root web",
    "build:web": "rsbuild build --root web",
    "demo": "pnpm build:web && pnpm server",
    "test": "node scripts/test.mjs offline",
    "test:live": "node scripts/test.mjs live",
    "test:browser": "pnpm build:web && node test/browser/run.cjs",
    "test:e2e": "node test/e2e/run.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:browser && pnpm test:e2e --narrow && pnpm evidence:check",
    "test:e2e:explore": "node test/e2e/run.mjs --explore",
    "test:e2e:stack": "node test/e2e/run.mjs --stack",
    "test:e2e:challenge": "node test/e2e/run.mjs --challenge",
    "release:candidate": "node scripts/release-candidate.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@fastnear/near-connect": "^0.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@near-intents-agent-api/sdk": "^0.7.1",
    "@nearai/inference-sdk": "^0.1.0",
    "@orpc/client": "2.0.0-beta.46",
    "@orpc/contract": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "effect": "4.0.6",
    "near-kit": "^0.20.2",
    "openai": "^7.43.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/intent": "0.5.6",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
