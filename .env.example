# API key (naa_…) from https://partners.demo.agentsonintents.com/ — backend only, never commit.
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# Owner, for the CLI owner scripts only: the dashboard signs owner actions with a connected wallet.
# A FullAccess key of this NEAR account signs agent creation, policy and grants.
# A dedicated low-value account: whatever this key can reach is what a leak can lose.
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PRIVATE_KEY=

# Saved by dashboard onboarding or `pnpm create-agent`.
AGENT_ID=
# Saved by dashboard onboarding or `pnpm issue-grant` (ngt_…): the treasury agent's credential. Backend only, never log it.
AGENT_GRANT_TOKEN=
# A new grant's token while the owner signs it; it replaces AGENT_GRANT_TOKEN once that grant is in force.
AGENT_GRANT_TOKEN_PENDING=

# Saved by the dashboard when the owner links a treasury: any NEAR account, or a Sputnik DAO (acts through Trezu).
TREASURY_ACCOUNT=

# Optional: another instance's own settings file (for example .env.payout), to run a second agent.
# Shared keys still come from .env; AGENT_ID, the grant, treasury and AUTOPILOT come only from that file.
# Set it in the environment (ENV_FILE=.env.payout pnpm server), not in .env.

# Optional: "off" makes this instance approve-only: it reads and approves as the owner but never sends,
# reconciles or serves invoices. Set it on every instance of an agent except its executor.
# EXECUTOR=off

# Saved by the dashboard's Automations page: "on" runs the autopilot on this instance's schedule.
# With ENV_FILE, set this in that instance's file; an inherited value is ignored.
# AUTOPILOT=

# Optional, for issuing a grant from a separate instance: the purpose it's labelled with
# (treasury, payout or invoices). Without it, the purpose follows the policy.
# GRANT_PURPOSE=

# Optional: the hosted dashboard's configuration file (default dashboard.json).
# DASHBOARD_FILE=
# Stable area identity is presentation only. Gateway-managed children use their entry's `area`.
# For a standalone/external server, set per process: DASHBOARD_AREA=treasury pnpm server
# Values: treasury or payables. Without it, legacy area inference follows swap permission.
# Required by the hosted dashboard (`pnpm hosted`): signs member sessions. A random value of at
# least 32 characters; the gateway refuses to start without one.
# SESSION_SECRET=
# TRUST_PROXY=true   (behind a proxy such as Railway: the gateway's and invoice page's rate limits key
#                     on each client, not the proxy)

# Optional: the NEAR RPC endpoint. Defaults to FastNear's (the paid one when FASTNEAR_API_KEY is set).
# Leave it commented out unless you set a URL: an empty value would replace the default.
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# For the Steward page (/steward, not in the menu): an LLM on NEAR AI Cloud proposes, the policy bounds it.
# From https://cloud.near.ai/dashboard
NEARAI_API_KEY=

# Optional: a FastNear API key (https://dashboard.fastnear.com). Sent as a header to the RPC and the
# Transactions and Transfers APIs. Without it only RPC switches to the free host; indexed API
# access is not guaranteed. Keep this key server-side. NEAR_RPC_URL overrides the keyed RPC host.
FASTNEAR_API_KEY=

# Optional public invoices on this same payout executor; never start a separate grant holder.
# INVOICES_PORT=8791
# INVOICES_HOST=127.0.0.1
# INVOICES_PUBLIC_HOST=localhost:8791
# INVOICES_SESSION_SECRET=<random 32+ byte secret for hosted sessions>
# INVOICES_TITLE=Submit an invoice
# Origin of a released Invoices frontend served on payee pages (HTTPS or loopback). Unset: the embedded invoice page.
# INVOICES_FRONTEND_URL=https://releases.example
# `pnpm invoices` defaults dashboard/RPC to loopback port 8790; override with AGENT_PORT.

# Agreements across hosts: the same random secret (32+ chars) on the invoices service and in the
# dashboard's .env.payout; AGREEMENTS_URL only in .env.payout. See docs/operations.md#payout-executor.
AGREEMENTS_URL=
AGREEMENTS_SECRET=

# Optional Telegram notifications from this executor: a payment waiting for approval, an operation with
# no proven outcome, the autopilot's open warnings and decisions. Messages carry no amounts or payees.
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_CHAT_ID=<your chat id>
# NOTIFY_NAME=Payout agent
# NOTIFY_LINK=https://proto.multiagency.ai/a/payout   (this agent's dashboard page; each message adds the page to act on)
